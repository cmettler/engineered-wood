<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EngineeredWood.Core\EngineeredWood.Core.csproj" />
    <ProjectReference Include="..\EngineeredWood.Parquet\EngineeredWood.Parquet.csproj" />
    <ProjectReference Include="..\EngineeredWood.Expressions\EngineeredWood.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.IO.Hashing" Version="9.*" />
    <PackageReference Include="System.Text.Json" Version="9.*" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.*" />
    <!-- [FABRICATOR-PATCH: OFFER-READY] 4.6.0 -> 4.6.3: System.Text.Json 9.* resolves 9.0.22, whose
         System.IO.Pipelines 9.0.22 is not on nuget.org, so Pipelines 10.0.0 is taken and needs >= 4.6.3;
         the 4.6.0 pin then fails restore with NU1605 (2026-10-25). Retired when upstream bumps it. -->
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EngineeredWood.DeltaLake.Table" />
    <InternalsVisibleTo Include="EngineeredWood.DeltaLake.Tests" />
    <InternalsVisibleTo Include="EngineeredWood.DeltaLake.Table.Tests" />
    <InternalsVisibleTo Include="EngineeredWood.DeltaLake.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
